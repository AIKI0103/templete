{
  "name": "astroweb",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "npm run fix:prettier && npm run fix:eslint && concurrently \"npm run astro dev\" \"npm run dev:svgSprite\" \"npm run dev:watch-convert2webp\"",
    "start": "NODE_ENV=local npm run dev",
    "build": "astro build",
    "build:sc": "astro build && node ./plugins/shortcode-replacer.mjs",
    "build:cms": "astro build",
    "build:dev": "NODE_ENV=development astro build",
    "preview": "astro preview",
    "astro": "astro",
    "sass": "npx sass --no-source-map src/styles:public/assets/css",
    "sass:watch": "'npm run sass' -- --watch",
    "dev:svgSprite": "chokidar './public/assets/svg/icons/*.svg' -c 'npm run svg-sprite' --initial",
    "dev:convert2webp": "node ./plugins/convert-to-webp.mjs",
    "dev:watch-convert2webp": "node ./plugins/convert-to-webp.mjs watch",
    "optimize-images:post": "node ./plugins/optimize-images.mjs",
    "svg-sprite": "svg-sprite --config svg-sprite.config.json ./public/assets/svg/icons/*.svg",
    "lint:eslint": "npx eslint 'src/**/*.{js,jsx,ts,tsx,astro}'",
    "lint:prettier": "npx prettier --check 'src/**/*.{js,ts,html,astro,css,scss}'",
    "lint:stylelint": "npx stylelint 'src/**/*.{css,scss,astro}'",
    "lint:markuplint": "npx markuplint 'src/**/*.{html,astro}'",
    "fix:eslint": "npx eslint 'src/**/*.{js,jsx,ts,tsx,astro}' --fix",
    "fix:prettier": "npx prettier --write 'src/**/*.{js,ts,html,astro,css,scss}'",
    "fix:stylelint": "npx stylelint 'src/**/*.{css,scss,astro}' --fix",
    "replace-path-css": "node postbuildReplaceInCss.cjs",
    "postcss:pre": "postcss ./public/assets/css/ --replace ./public/assets/css/**/*.css",
    "postcss:post": "postcss ./dist/assets/css/ --replace ./dist/assets/css/**/*.css",
    "cssOptimize:post": "IS_CUSTOM=true npm run postcss:post && IS_CUSTOM=minify npm run postcss:post && npm run replace-path-css -- ./dist/assets/css",
    "removeMinCss": "node -e 'fs.rmSync(`./public/assets/css/main-minLG.css`, {recursive:true, force:true})' && node -e 'fs.rmSync(`./public/assets/css/main-minMD.css`, {recursive:true, force:true})'",
    "prestart": "npm run sass && npm run postcss:pre",
    "prebuild": "npm run sass && npm run postcss:pre && npm run removeMinCss",
    "postbuild": "npx prettier --write './dist/**/*.html' && npm run cssOptimize:post && npm run optimize-images:post",
    "prestart:cms": "npm run prestart",
    "prebuild:cms": "npm run prebuild",
    "postbuild:cms": "npm run postbuild && npm run remove-dist-cms-assets && npm run copy-assets",
    "remove-dist-cms-assets": "node -e 'fs.rmSync(`./dist-cms/wp/wp-content/themes/案件毎に変更してください/assets`, {recursive:true, force:true})'",
    "copy-assets": "cpy 'dist/assets/**/*.*' 'dist-cms/wp/wp-content/themes/案件毎に変更してください/assets/' --parents"
  },
  "dependencies": {
    "@astrojs/tailwind": "^5.1.0",
    "@fontsource/noto-sans-jp": "^5.0.16",
    "@splidejs/splide": "^4.1.4",
    "@splidejs/splide-extension-auto-scroll": "^0.5.3",
    "@splidejs/splide-extension-intersection": "^0.2.0",
    "@types/webfontloader": "^1.6.37",
    "astro": "^3.5.4",
    "astro-breadcrumbs": "^1.8.0",
    "scroll-hint": "^1.2.8",
    "tailwindcss": "^3.4.1"
  },
  "devDependencies": {
    "@markuplint/astro-parser": "^3.11.0",
    "@typescript-eslint/eslint-plugin": "^6.11.0",
    "@typescript-eslint/parser": "^6.11.0",
    "autoprefixer": "^10.4.16",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^8.2.2",
    "cpy-cli": "^5.0.0",
    "cssnano": "^6.0.1",
    "dialog-closedby-polyfill": "1.1.0",
    "eslint": "^8.53.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-config-standard-with-typescript": "^39.1.1",
    "eslint-plugin-astro": "^0.29.1",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-n": "^16.3.1",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-unused-imports": "^3.0.0",
    "invokers-polyfill": "0.5.4",
    "markuplint": "^3.14.0",
    "postcss": "^8.4.31",
    "postcss-cli": "^10.1.0",
    "postcss-custom-media": "^10.0.2",
    "postcss-extract-media-query": "^3.0.0",
    "postcss-html": "^1.5.0",
    "postcss-preset-env": "^9.3.0",
    "postcss-sort-media-queries": "^5.2.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.12.3",
    "prettier-plugin-tailwindcss": "^0.5.7",
    "sass": "^1.69.5",
    "sharp": "^0.32.6",
    "stylelint": "^15.11.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-recess-order": "^4.3.0",
    "stylelint-config-standard-scss": "^11.1.0",
    "stylelint-declaration-block-no-ignored-properties": "^2.7.0",
    "stylelint-no-unsupported-browser-features": "^7.0.0",
    "stylelint-prettier": "^4.0.2",
    "stylelint-selector-bem-pattern": "^3.0.1",
    "svg-sprite": "^2.0.2",
    "typescript": "^5.2.2"
  },
  "browserslist": [
    "> 2% in JP and last 2 major versions",
    "> 0.2% and not dead"
  ]
}
