---
import Flex from '../../components/Blocks/Flex.astro'
import FeedNews from '../../components/Feed/FeedNews.astro'
import WpPagination from '../../components/Wp/WpPagination.astro'
import Layout from '../../layouts/Layout.astro'

// ページ情報
const page = {
  type: 'page', // home | page | single
  sub: true, // サブエリアの追加
  slug: 'news',
}

// SEO・metaタグ関連
const seo = {
  title: 'お知らせ', // 基本必須（titleTagが優先される）
  // titleTag: 'Webサイト構築用 Astroフレームワーク', // 必要あれば（タイトルタグ上書き）
  // description: '', // 必要あれば
  // keywords: 'キーワード1,キーワード2', // 必要あれば
  // ogURL: '', // 必要あれば（基本自動出力）
  // ogType: '', // 必要あれば（基本自動出力）
  // ogImage: '', // 必要あれば（基本自動出力）
  // ogLocale: '', // 必要あれば（基本自動出力）
}

// ヒーローコンポーネントに渡すprops
const hero = {
  parentTitle: '',
  mainTitle: 'お知らせ',
  subTitle: 'News',
  bgImage: 'news',
}

// 【仕様未確定】パンくずリスト false || true || [{text: '/', href: '#'}, ...]
const customCrumbs = [
  {
    text: seo.title,
    href: '',
  },
]
