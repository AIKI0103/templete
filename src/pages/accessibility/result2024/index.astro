---
import Container from '../../../components/Blocks/Container.astro'
import HeadingLine from '../../../components/Blocks/HeadingLine.astro'
import Layout from '../../../layouts/Layout.astro'

// ページ情報
const page = {
  type: 'page', // home | page | single
  sub: false, // サブエリアの追加
  slug: 'result2024',
}

// SEO・metaタグ関連
const seo = {
  title: '2024年度試験結果 | ウェブアクセシビリティ方針', // 基本必須（titleTagが優先される）
  // titleTag: 'Webサイト構築用 Astroフレームワーク', // 必要あれば（タイトルタグ上書き）
  // description: '', // 必要あれば
  // keywords: 'キーワード1,キーワード2', // 必要あれば
  // ogURL: '', // 必要あれば（基本自動出力）
  // ogType: '', // 必要あれば（基本自動出力）
  // ogImage: '', // 必要あれば（基本自動出力）
  // ogLocale: '', // 必要あれば（基本自動出力）
}

// ヒーローコンポーネントに渡すprops
const hero = {
  parentTitle: '',
  mainTitle: 'ウェブアクセシビリティ方針',
  subTitle: 'Accessibility',
  bgImage: 'accessibility',
}

// 【仕様未確定】パンくずリスト false || true || [{text: '/', href: '#'}, ...]
const customCrumbs = [
  {
    text: 'ウェブアクセシビリティ方針',
    href: '../',
  },
  {
    text: '2024年度試験結果',
    href: '',
  },
]
---

<Layout page={page} seo={seo} hero={hero} breadcrumbs={customCrumbs}>
  <div class="py-[3rem] md:py-[7rem]">
    <Container size="md" className="">
      <div class="py-[1.5rem]">
        <div class="c-textarea">
          <p>
            試験結果の表示<br />株式会社〇〇〇〇〇〇HPは「ウェブアクセシビリティ方針」に記載している株式会社〇〇〇〇〇のウェブサイト（https:/○○○○○○○○.jp/）について、JIS X
            8341-3:2016の附属書JB（参考）試験方法に基づいた試験を行った結果を以下の通り公表します。
          </p>
        </div>
      </div>

      <section class="py-[1.5rem]">
        <HeadingLine className="mb-[1.5rem]">試験実施期間</HeadingLine>
        <div class="c-textarea">
          <p>2024年3月</p>
        </div>
      </section>

      <section class="py-[1.5rem]">
        <HeadingLine className="mb-[1.5rem]">試験方法</HeadingLine>
        <div class="c-textarea">
          <p>ウェブページ単位での試験</p>
        </div>
      </section>

      <section class="py-[1.5rem]">
        <HeadingLine className="mb-[1.5rem]">適用規格</HeadingLine>
        <div class="c-textarea">
          <p>JIS X 8341-3:2016</p>
        </div>
      </section>

      <section class="py-[1.5rem]">
        <HeadingLine className="mb-[1.5rem]">達成等級</HeadingLine>
        <div class="c-textarea">
          <p>JIS X 8341-3:2016のウェブアクセシビリティ達成等級 A</p>
        </div>
      </section>

      <section class="py-[1.5rem]">
        <HeadingLine className="mb-[1.5rem]">試験を実施したページ</HeadingLine>
        <div class="c-textarea">
          <ul class="c-list">
            <li class="mb-[1rem] pl-[1.2em] -indent-[1.2em] md:mb-[1.5rem]"><span class="mr-[1rem]">■ トップページ</span>https://test-fv.net/higo_mokkos/design/img/top_.jpg</li>
            <li class="mb-[1rem] pl-[1.2em] -indent-[1.2em] md:mb-[1.5rem]"><span class="mr-[1rem]">■ 業務内容</span>https://test-fv.net/higo_mokkos/design/img/service.jpg</li>
            <li class="mb-[1rem] pl-[1.2em] -indent-[1.2em] md:mb-[1.5rem]"><span class="mr-[1rem]">■ 会社概要</span>https://test-fv.net/higo_mokkos/design/img/company.jpg</li>
            <li class="mb-[1rem] pl-[1.2em] -indent-[1.2em] md:mb-[1.5rem]"><span class="mr-[1rem]">■ お知らせ</span>https://test-fv.net/higo_mokkos/design/img/news.jpg</li>
            <li class="mb-[1rem] pl-[1.2em] -indent-[1.2em] md:mb-[1.5rem]"><span class="mr-[1rem]">■ ブログ</span>https://test-fv.net/higo_mokkos/design/img/blog.jpg</li>
            <li class="mb-[1rem] pl-[1.2em] -indent-[1.2em] md:mb-[1.5rem]"><span class="mr-[1rem]">■ 採用情報</span>https://test-fv.net/higo_mokkos/design/img/recruit.jpg</li>
            <li class="mb-[1rem] pl-[1.2em] -indent-[1.2em] md:mb-[1.5rem]"><span class="mr-[1rem]">■ お問い合わせ</span>https://test-fv.net/higo_mokkos/design/img/contact.jpg</li>
            <li class="mb-[1rem] pl-[1.2em] -indent-[1.2em] md:mb-[1.5rem]">
              <span class="mr-[1rem]">■ ウェブアクセシビリティ方針</span>https://test-fv.net/higo_mokkos/design/img/web_accessibility.jpg
            </li>
            <li class="pl-[1.2em] -indent-[1.2em]"><span class="mr-[0.5em]">■ プライバシーポリシー</span>https://test-fv.net/higo_mokkos/design/img/privacy.jpg</li>
          </ul>
        </div>
      </section>

      <section class="py-[1.5rem]">
