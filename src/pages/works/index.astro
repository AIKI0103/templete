              text: 'テキストが入ります。',
              tags: ['カテゴリーB', 'カテゴリーC'],
            },
          ].map((item) => {
            return (
              <div class="w-full md:w-1/2 lg:w-1/4">
                <FeedWorks href={item.href} className={item.className} imgSrc={item.imgSrc} area={item.area} title={item.title} text={item.text} tags={item.tags} />
              </div>
            )
          })
        }
      </Flex>
    </Container>
  </div>
</Layout>
